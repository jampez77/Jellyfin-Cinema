{
  "name": "screenharbour",
  "version": "0.2.34",
  "private": true,
  "description": "A cinematic interface for Jellyfin, with personal collection rows and in-player navigation",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "dev": "node scripts/dev.mjs",
